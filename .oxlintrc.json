{
    "$schema": "./node_modules/oxlint/configuration_schema.json",
    "plugins": ["typescript", "unicorn", "oxc", "react", "import", "nextjs"],
    "categories": {
        "correctness": "error",
        "suspicious": "warn",
        "perf": "warn"
    },
    "env": {
        "builtin": true,
        "browser": true,
        "node": true,
        "es2025": true
    },
    "ignorePatterns": [".next", "out", "dist", "build", "next-env.d.ts"],
    "rules": {
        "react/react-in-jsx-scope": "off",
        "import/no-unassigned-import": "off",
        "nextjs/no-img-element": "warn"
    },
    "settings": {
        "react": {
            "version": "19.0"
        }
    }
}
